# Copy to `.env` and fill in. The app loads this via flutter_dotenv.
# Select the environment at build time with --dart-define=ENV=dev|staging|prod.

# Dev
DEV_API_BASE_URL=api.dev.xtridelink.com

# Staging
STAGING_API_BASE_URL=api.staging.xtridelink.com
STAGING_BAXI_API_BASE_URL=
STAGING_BAXI_API_KEY=

# Production
PROD_API_BASE_URL=api.xtridelink.com
BAXI_API_BASE_URL=
BAXI_API_KEY=
